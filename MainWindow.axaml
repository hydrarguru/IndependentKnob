<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="520"
        x:Class="IndependantKnob.MainWindow"
        Title="IndependantKnob"
        Icon="/Assets/icon.ico"
        Width="460" Height="520" MinWidth="380" MinHeight="380">
    <Window.Resources>
        <!-- Material Design Icons (Pictogrammers, Apache 2.0), 24x24 paths. -->
        <StreamGeometry x:Key="TrashIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="UndoIcon">M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z</StreamGeometry>
        <StreamGeometry x:Key="PlusIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Setting rows: label on the left, control on the right. -->
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16,12">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#E05050" TextWrapping="Wrap" IsVisible="False" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <ComboBox x:Name="AddBox" HorizontalAlignment="Stretch" PlaceholderText="Add an app that is playing audio" />
            <Button x:Name="AddButton" Grid.Column="1" Margin="8,0,0,0" Classes="icon" IsEnabled="False"
                    ToolTip.Tip="Add app" AutomationProperties.Name="Add app">
                <PathIcon Data="{StaticResource PlusIcon}" />
            </Button>
        </Grid>

        <!-- Hidden rows take no space, so each mode only shows the settings it uses. -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Grid.IsSharedSizeScope="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="Knob controls" />
                <!-- Item order matches the TargetMode enum. -->
                <ComboBox x:Name="ModeBox" Grid.Column="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem ToolTip.Tip="Turning adjusts the selected app; pressing the knob switches to the next app.">Selected app (press to switch)</ComboBoxItem>
                    <ComboBoxItem ToolTip.Tip="Controls the app you are using if it's listed, otherwise the app set below.">App you're using</ComboBoxItem>
                    <ComboBoxItem ToolTip.Tip="Each app gets a key in the list below; hold it while turning.">App for the key you hold</ComboBoxItem>
                </ComboBox>
            </Grid>

            <Grid x:Name="ActivationPanel">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="Only while holding" />
                <!-- Order matches MainWindow.Keys. -->
                <ComboBox x:Name="ActivationBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          ToolTip.Tip="When set, the knob only controls apps while this key is held; plain turns stay Windows volume.">
                    <ComboBoxItem>Nothing</ComboBoxItem>
                    <ComboBoxItem>Ctrl</ComboBoxItem>
                    <ComboBoxItem>Shift</ComboBoxItem>
                    <ComboBoxItem>Alt</ComboBoxItem>
                </ComboBox>
            </Grid>

            <Grid x:Name="CyclePanel" RowDefinitions="Auto,Auto">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="Mute with" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                    <!-- Item order matches the MuteTrigger enum. -->
                    <ComboBox x:Name="MuteTriggerBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem>Double-press</ComboBoxItem>
                        <ComboBoxItem>Modifier + press</ComboBoxItem>
                        <ComboBoxItem>Press and hold</ComboBoxItem>
                    </ComboBox>
                    <!-- MainWindow.Keys minus None. -->
                    <ComboBox x:Name="MuteModifierBox" Grid.Column="1" Margin="8,0,0,0">
                        <ComboBoxItem>Ctrl</ComboBoxItem>
                        <ComboBoxItem>Shift</ComboBoxItem>
                        <ComboBoxItem>Alt</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="KeyClash" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="#E05050" TextWrapping="Wrap"
                           Text="Pick a different mute key than the one you hold." />
            </Grid>

            <Grid x:Name="FocusedPanel">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="Otherwise control" />
                <ComboBox x:Name="DefaultAppBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Used when the app you are using isn't in the list." />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="Overlay position" />
                <!-- Item order matches the OverlayPosition enum. -->
                <ComboBox x:Name="OverlayPositionBox" Grid.Column="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem>Bottom</ComboBoxItem>
                    <ComboBoxItem>Top</ComboBoxItem>
                    <ComboBoxItem>Left (upright)</ComboBoxItem>
                    <ComboBoxItem>Right (upright)</ComboBoxItem>
                    <ComboBoxItem>Center</ComboBoxItem>
                </ComboBox>
            </Grid>

            <Separator Margin="0,6" />
            <TextBlock Text="Apps" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Margin="0,6,0,0">
            <StackPanel Spacing="4">
                <TextBlock x:Name="EmptyHint" Opacity="0.7" TextWrapping="Wrap"
                           Text="No apps yet. Start playing audio in an app, then add it below. Until then the knob works as normal Windows volume." />
                <StackPanel x:Name="AppList" Spacing="4" />

                <StackPanel x:Name="IgnoredPanel" Spacing="4" Margin="0,12,0,0">
                    <TextBlock Text="Not suggested" FontWeight="SemiBold" />
                    <StackPanel x:Name="IgnoredList" Spacing="4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
