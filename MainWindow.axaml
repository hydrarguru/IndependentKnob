<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="560"
        x:Class="IndependantKnob.MainWindow"
        Title="IndependantKnob"
        Icon="/Assets/icon.ico"
        Width="480" Height="560" MinWidth="380" MinHeight="400">
    <DockPanel Margin="16">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#E05050" TextWrapping="Wrap" IsVisible="False" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <ComboBox x:Name="AddBox" HorizontalAlignment="Stretch" PlaceholderText="Choose an app that is playing audio" />
            <Button x:Name="AddButton" Grid.Column="1" Margin="8,0,0,0" Content="Add" IsEnabled="False" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,8">
            <StackPanel Spacing="4">
                <TextBlock Text="The knob controls" FontWeight="SemiBold" />
                <!-- Item order matches the TargetMode enum. -->
                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem>The selected app (press the knob to switch app)</ComboBoxItem>
                    <ComboBoxItem>The app you are using</ComboBoxItem>
                    <ComboBoxItem>The app picked by the modifier key you hold</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="ActivationPanel" Spacing="4">
                <TextBlock Text="Only while holding" FontWeight="SemiBold" />
                <!-- Order matches MainWindow.Keys. -->
                <ComboBox x:Name="ActivationBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem>Nothing (the knob always controls apps)</ComboBoxItem>
                    <ComboBoxItem>Ctrl (plain turns stay Windows volume)</ComboBoxItem>
                    <ComboBoxItem>Shift (plain turns stay Windows volume)</ComboBoxItem>
                    <ComboBoxItem>Alt (plain turns stay Windows volume)</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="CyclePanel" Spacing="4">
                <TextBlock Text="Mute with" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Item order matches the MuteTrigger enum. -->
                    <ComboBox x:Name="MuteTriggerBox">
                        <ComboBoxItem>Double-press</ComboBoxItem>
                        <ComboBoxItem>Modifier + press</ComboBoxItem>
                    </ComboBox>
                    <!-- MainWindow.Keys minus None. -->
                    <ComboBox x:Name="MuteModifierBox">
                        <ComboBoxItem>Ctrl</ComboBoxItem>
                        <ComboBoxItem>Shift</ComboBoxItem>
                        <ComboBoxItem>Alt</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="KeyClash" Foreground="#E05050" TextWrapping="Wrap"
                           Text="Mute needs a different key than the one you hold to control apps." />

            </StackPanel>

            <StackPanel x:Name="FocusedPanel" Spacing="4">
                <TextBlock Text="When the app you are using isn't listed, control" FontWeight="SemiBold" />
                <ComboBox x:Name="DefaultAppBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <TextBlock Text="Apps" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="6">
                <TextBlock x:Name="EmptyHint" Opacity="0.7" TextWrapping="Wrap"
                           Text="No apps yet. Start playing audio in an app, then add it below. Until then the knob works as normal Windows volume." />
                <StackPanel x:Name="AppList" Spacing="6" />

                <StackPanel x:Name="IgnoredPanel" Spacing="6" Margin="0,16,0,0">
                    <TextBlock Text="Not suggested" FontWeight="SemiBold" />
                    <StackPanel x:Name="IgnoredList" Spacing="6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
