<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IndependentKnob.OverlayWindow"
        Title="IndependentKnob overlay"
        Width="380" Height="92"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        TransparencyLevelHint="Transparent" Background="Transparent"
        RequestedThemeVariant="Dark">
    <!-- Fixed dark look, like the Windows volume flyout, so it reads on any wallpaper or theme. -->
    <!-- Starts faded out and slightly shrunk; OverlayWindow.Animate fades and zooms it in and out. -->
    <Border x:Name="Card" CornerRadius="10" Padding="18,14" Background="#E6202020"
            Opacity="0" RenderTransform="scale(0.96)">
        <!-- Laid out horizontally here; OverlayWindow.Arrange rearranges it upright for the left/right edges. -->
        <Grid x:Name="Layout" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
            <!-- Hidden when the app has no icon, so the text takes the full width. -->
            <Image x:Name="AppIcon" Grid.RowSpan="2" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AppName" Grid.Column="1" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Level" Grid.Column="2" FontSize="17" Margin="12,0,0,0" />
            <!-- Drag the dot (or click the line) to set the volume; whole percents, like the label. -->
            <Slider x:Name="Bar" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                    Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Focusable="False" />
        </Grid>
    </Border>
</Window>
